{
  "manifest_version": 2,
  "name": "MyLiteratureVault",
  "version": "0.3.1",
  "description": "Synchronizes MyLiteratureVault research projects, collections, and linked references with Zotero.",
  "author": "Datenflix007",
  "homepage_url": "https://github.com/Datenflix007/MyLiteratureVault",
  "applications": {
    "zotero": {
      "id": "myliteraturevault@datenflix007.github",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "myliteraturevault@datenflix007.github",
      "strict_min_version": "115.0",
      "strict_max_version": "*"
    }
  }
}
